<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:layout_gravity="center"
    android:background="@drawable/bg_multiview_control_bar"
    android:gravity="center"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/btn_multiview_indicator"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:contentDescription="@null"
        android:focusable="true"
        android:src="@drawable/ic_multiview_2screen_selector" />

    <ImageView
        android:id="@+id/btn_multiview_pip"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:contentDescription="@null"
        android:focusable="true"
        android:src="@drawable/ic_multiview_pip_selector" />

    <ImageView
        android:id="@+id/btn_multiview_swap"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:contentDescription="@null"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_multiview_swap_selector" />

</LinearLayout>